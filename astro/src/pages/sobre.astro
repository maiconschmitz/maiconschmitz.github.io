---
import Base from '@/layouts/Base.astro'
import { profile } from '@/data/portfolio'
---

<Base title="Sobre" description={`Sobre ${profile.name} — ${profile.role}.`}>
  <div class="container">
    <div class="page-hero">
      <h1>Sobre</h1>
      <p>{profile.role} · {profile.location}</p>
    </div>

    <div class="page-content post-content">
      {profile.about.paragraphs.map((p) => <p>{p}</p>)}

      <div class="deliverables-box">
        <h2 class="deliverables-title">O que entrego na prática</h2>
        <ul class="deliverables-list" role="list">
          {profile.about.deliverables.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <h2>Contato</h2>
      <p>
        Você pode me encontrar no
        <a href="https://www.linkedin.com/in/maiconschmitz">LinkedIn</a>,
        no <a href="https://github.com/maiconschmitz">GitHub</a>,
        no <a href="https://twitter.com/maiconschmitz">Twitter</a> ou por
        <a href="mailto:contato@maiconschmitz.com.br">e-mail</a>.
      </p>
    </div>
  </div>
</Base>
