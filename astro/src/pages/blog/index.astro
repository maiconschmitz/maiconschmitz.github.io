---
import Base from '@/layouts/Base.astro'
import PostCard from '@/components/PostCard.astro'
import Pagination from '@/components/Pagination.astro'
import { getSortedPosts } from '@/utils/posts'

const PAGE_SIZE = 10
const allPosts = await getSortedPosts()
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE)
const posts = allPosts.slice(0, PAGE_SIZE)
---

<Base title="Blog" description="Artigos e anotações técnicas de Maicon Schmitz sobre desenvolvimento Web, Mobile, DevOps e IoT.">
  <div class="container">
    <div class="page-hero">
      <h1>Blog</h1>
      <p>Artigos e anotações técnicas · {allPosts.length} posts</p>
    </div>

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination
      currentPage={1}
      totalPages={totalPages}
      prevUrl={null}
      nextUrl={totalPages > 1 ? '/blog/pagina/2/' : null}
    />
  </div>
</Base>
