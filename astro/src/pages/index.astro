---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import RepoCard from '@/components/RepoCard.astro'
import PostCard from '@/components/PostCard.astro'
import { getSortedPosts } from '@/utils/posts'
import { profile, socials, skills, principles, projects, openSource } from '@/data/portfolio'

const latestPosts = (await getSortedPosts()).slice(0, 4)
const primarySocials = socials.filter((s) => 'primary' in s && s.primary)
---

<Base title={profile.name}>
  {/* ── Hero ─────────────────────────────────────────── */}
  <section class="hero-portfolio">
    <div class="container container--wide">
      <span class="hero-portfolio__mono" aria-hidden="true">{profile.initials}</span>
      <p class="hero-portfolio__eyebrow">{profile.role} · {profile.location}</p>
      <h1 class="hero-portfolio__name">{profile.name}</h1>
      <p class="hero-portfolio__tagline">{profile.tagline}</p>

      <div class="hero-portfolio__intro">
        {profile.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="hero-portfolio__cta">
        {primarySocials.map((s) => (
          <a
            class={`btn ${s.icon === 'linkedin' ? 'btn--primary' : 'btn--ghost'}`}
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={s.icon} size={18} /> {s.label}
          </a>
        ))}
        <a class="btn btn--ghost" href="#contato">
          <Icon name="mail" size={18} /> Contato
        </a>
      </div>
    </div>
  </section>

  {/* ── Conhecimentos ────────────────────────────────── */}
  <section class="section">
    <div class="container container--wide">
      <header class="section__head">
        <h2>Conhecimentos</h2>
        <p>Tecnologias, arquitetura e ferramentas consolidadas na prática.</p>
      </header>

      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul class="chip-list" role="list">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Como Trabalho ────────────────────────────────── */}
  <section class="section section--alt">
    <div class="container container--wide">
      <header class="section__head">
        <h2>Como Trabalho</h2>
        <p>Princípios de engenharia e cultura técnica que guiam minhas decisões.</p>
      </header>

      <div class="principles-grid">
        {principles.map((item, idx) => (
          <article class="principle-card">
            <div class="principle-card__head">
              <span class="principle-card__num">0{idx + 1}</span>
              <span class="badge">{item.subtitle}</span>
            </div>
            <h3 class="principle-card__title">{item.title}</h3>
            <p class="principle-card__desc">{item.description}</p>
          </article>
        ))}
      </div>

      <footer class="principles-footer">
        <p>
          Para consultar o histórico cronológico de cargos, empresas e recomendações, acesse meu{' '}
          <a href="https://www.linkedin.com/in/maiconschmitz" target="_blank" rel="noopener noreferrer">
            LinkedIn &rarr;
          </a>
        </p>
      </footer>
    </div>
  </section>

  {/* ── Projetos ─────────────────────────────────────── */}
  <section class="section">
    <div class="container container--wide">
      <header class="section__head">
        <h2>Projetos</h2>
        <p>Alguns trabalhos que fiz.</p>
      </header>

      <div class="cards-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  {/* ── Open source ──────────────────────────────────── */}
  <section class="section section--alt">
    <div class="container container--wide">
      <header class="section__head">
        <h2>Open source</h2>
        <p>Código que mantenho público no GitHub.</p>
      </header>

      <div class="cards-grid">
        {openSource.map((repo) => <RepoCard repo={repo} />)}
      </div>

      <p class="section__more">
        <a href="https://github.com/maiconschmitz" target="_blank" rel="noopener noreferrer">
          Ver tudo no GitHub <Icon name="arrow" size={16} />
        </a>
      </p>
    </div>
  </section>

  {/* ── Últimos posts ────────────────────────────────── */}
  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container container--wide">
        <header class="section__head">
          <h2>Do blog</h2>
          <p>Anotações técnicas — voltando aos poucos a escrever.</p>
        </header>

        <div class="post-list">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>

        <p class="section__more">
          <a href="/blog">Todos os posts <Icon name="arrow" size={16} /></a>
        </p>
      </div>
    </section>
  )}

  {/* ── Contato ──────────────────────────────────────── */}
  <section class="section section--alt" id="contato">
    <div class="container container--wide">
      <div class="contact">
        <h2>Vamos conversar?</h2>
        <p>
          Aberto a projetos, parcerias e boas ideias. Me encontra nos canais abaixo.
        </p>
        <div class="hero-portfolio__cta">
          {socials.map((s) => (
            <a
              class="btn btn--ghost"
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <Icon name={s.icon} size={18} /> {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
